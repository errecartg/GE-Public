def run_combined_analysis(b):
    global START_DATE
    with analysis_output:
        clear_output()
        # Update START_DATE from widget
        if start_date_picker.value is not None:
            START_DATE = start_date_picker.value.strftime("%Y-%m-%d")
        else:
            START_DATE = "2007-01-01"
        selected = list(portfolio_selector.value)
        if not selected:
            print("Please select at least one portfolio.")
            return
        results = {}
        # Collect fixed (primary) portfolios
        for name in selected:
            if name in primary_portfolios:
                results[name] = primary_portfolios[name]
            elif name in custom_portfolios:
                defn = custom_portfolios[name]
                analysis = analyze_portfolio(defn["tickers"], defn["weights"])
                if analysis is None:
                    print(f"Analysis failed for {name}.")
                    continue
                results[name] = {"price": analysis["price"], "returns": analysis["returns"], "metrics": analysis["metrics"], "df": analysis["df"]}

        # Prepare combined cumulative performance DataFrame and metrics list
        combined_ts = pd.DataFrame()
        metrics_list = []
        plt.figure(figsize=(10,6))
        for p, data in results.items():
            ts = data["price"]
            cum_perf = ts / INITIAL_INVESTMENT
            combined_ts[p+"_CumPerf"] = cum_perf
            plt.plot(ts.index, cum_perf, label=p)
            ret = data["returns"]
            ann_return = ret.mean() * 252
            vol = ret.std() * np.sqrt(252)
            dd = max_drawdown(ret)
            sharpe = ann_return / vol if vol != 0 else np.nan
            var_t = compute_var_t(ret, alpha=0.05)
            recov = compute_recovery_time(ts)
            metrics_list.append({
                "Portfolio": p,
                "Annual Return": ann_return,
                "Volatility": vol,
                "Max Drawdown": dd,
                "Sharpe Ratio": sharpe,
                "VaR (5%)": var_t,
                "Recovery Time (months)": recov
            })
        plt.title("Cumulative Performance")
        plt.xlabel("Date")
        plt.ylabel("Multiple of Initial Investment")
        plt.legend()
        plt.grid(True)
        plt.show()

        # Plot distribution of daily returns
        plt.figure(figsize=(10,6))
        for p, data in results.items():
            ret = data["returns"]
            plt.hist(ret, bins=50, alpha=0.5, label=p, density=True)
        plt.title("Distribution of Daily Returns")
        plt.xlabel("Daily Return")
        plt.ylabel("Density")
        plt.legend()
        plt.grid(True)
        plt.show()

        # Underwater (drawdown) plot
        plt.figure(figsize=(10,6))
        for p, data in results.items():
            ret = data["returns"]
            cum = (1+ret).cumprod()
            peak = cum.cummax()
            dd_series = (cum - peak) / peak
            plt.plot(cum.index, dd_series, label=p)
        plt.title("Underwater (Drawdown) Plot")
        plt.xlabel("Date")
        plt.ylabel("Drawdown")
        plt.legend()
        plt.grid(True)
        plt.show()

        # Create a donut chart for each portfolio
        donut_filenames = {}
        for p in results.keys():
            if p == "Cash":
                contrib = {"Cash": primary_portfolios["Cash"]["price"].iloc[-1]}
            elif p == "100% SPY":
                contrib = {"SPY": primary_portfolios["100% SPY"]["price"].iloc[-1]}
            elif p == "Multi-Asset":
                contrib = {t: INITIAL_INVESTMENT * (weights_primary[t] * primary_df[t+"_norm"].iloc[-1]) for t in weights_primary}
            else:
                analysis_df = results[p]["df"]
                defn = custom_portfolios[p]
                contrib = {t: INITIAL_INVESTMENT * (defn["weights"][t] * analysis_df[t+"_norm"].iloc[-1]) for t in defn["tickers"]}
            labels = list(contrib.keys())
            sizes = [contrib[k] for k in labels]
            fig, ax = plt.subplots(figsize=(6,6))
            wedges, texts, autotexts = ax.pie(sizes, labels=labels, autopct='%1.1f%%', startangle=90, wedgeprops={'width':0.4})
            ax.set_title(f"Donut Chart for {p}")
            ax.axis('equal')
            donut_filename = f"donut_{p}.png"
            plt.savefig(donut_filename, bbox_inches='tight')
            plt.show()
            donut_filenames[p] = donut_filename

        # Create and display metrics DataFrame
        metrics_df = pd.DataFrame(metrics_list)
        metrics_df["Annual Return"] = metrics_df["Annual Return"].map("{:.2%}".format)
        metrics_df["Volatility"] = metrics_df["Volatility"].map("{:.2%}".format)
        metrics_df["Max Drawdown"] = metrics_df["Max Drawdown"].map("{:.2%}".format)
        metrics_df["Sharpe Ratio"] = metrics_df["Sharpe Ratio"].map("{:.2f}".format)
        metrics_df["VaR (5%)"] = metrics_df["VaR (5%)"].map("{:.2%}".format)
        metrics_df["Recovery Time (months)"] = metrics_df["Recovery Time (months)"].map(lambda x: f"{x:.1f}" if pd.notnull(x) else "N/A")
        print("Performance Metrics:")
        print(metrics_df.to_string(index=False))

        # Save outputs to Excel with a worksheet per donut chart
        with pd.ExcelWriter("combined_portfolio_analysis.xlsx", engine="xlsxwriter") as writer:
            combined_ts.to_excel(writer, sheet_name="Cumulative Performance")
            metrics_df.to_excel(writer, sheet_name="Performance Metrics", index=False)
            workbook  = writer.book
            for p, fname in donut_filenames.items():
                worksheet = workbook.add_worksheet(f"Donut_{p}")
                writer.sheets[f"Donut_{p}"] = worksheet
                if os.path.exists(fname):
                    worksheet.insert_image('B2', fname)
        print("Outputs saved to 'combined_portfolio_analysis.xlsx'")

